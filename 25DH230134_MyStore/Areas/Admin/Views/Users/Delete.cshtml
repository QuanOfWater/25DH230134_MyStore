@model _25DH230134_MyStore.Models.User
@{
    ViewBag.Title = "Xóa tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>XÓA TÀI KHOẢN ADMIN</h2>
<h4 class="text-danger">Bạn có chắc muốn xóa tài khoản "@Model.Username"?</h4>
<hr />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
}