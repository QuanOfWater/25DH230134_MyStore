@model _25DH230134_MyStore.Models.User
@{
    ViewBag.Title = "Chi tiết tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>CHI TIẾT TÀI KHOẢN</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">Tên đăng nhập</dt>
    <dd class="col-sm-9">@Model.Username</dd>
    <dt class="col-sm-3">Quyền</dt>
    <dd class="col-sm-9">Admin</dd>
</dl>
<p>
    @Html.ActionLink("Đổi mật khẩu", "Edit", new { id = Model.Username }, new { @class = "btn btn-primary" })
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
</p>