@model _25DH230134_MyStore.Models.Customer
@{
    ViewBag.Title = "Xóa khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>XÓA KHÁCH HÀNG</h2>
@if (Model.Orders.Any())
{
    <div class="alert alert-warning">Khách hàng này đã có @Model.Orders.Count đơn hàng nên <strong>không thể xóa</strong>.</div>
}
else
{
    <h4 class="text-danger">Bạn có chắc muốn xóa khách hàng này (kèm tài khoản đăng nhập)?</h4>
}
<hr />
<dl class="row">
    <dt class="col-sm-3">Họ tên</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>
    <dt class="col-sm-3">Số điện thoại</dt>
    <dd class="col-sm-9">@Model.CustomerPhone</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.CustomerEmail</dd>
    <dt class="col-sm-3">Tên đăng nhập</dt>
    <dd class="col-sm-9">@Model.Username</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    if (!Model.Orders.Any())
    {
        <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    }
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
}