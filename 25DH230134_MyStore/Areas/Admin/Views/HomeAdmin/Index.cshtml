@model _25DH230134_MyStore.Models.ViewModel.DashboardVM
@{
    ViewBag.Title = "Trang quản trị";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>TRANG QUẢN TRỊ – THỐNG KÊ</h2>

@* 4 Ô SỐ LIỆU *@
<div class="row g-3 my-3">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <div>Tổng đơn hàng</div><h3>@Model.TotalOrders</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div>Doanh thu (không tính đơn hủy)</div><h3>@Model.TotalRevenue.ToString("N0") ₫</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <div>Khách hàng</div><h3>@Model.TotalCustomers</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <div>Sản phẩm</div><h3>@Model.TotalProducts</h3>
            </div>
        </div>
    </div>
</div>

@* CHỌN NĂM CHO BIỂU ĐỒ DOANH THU *@
@using (Html.BeginForm("Index", "HomeAdmin", FormMethod.Get, new { @class = "d-flex gap-2 align-items-center mb-2" }))
{
    <label>Năm:</label>
    <input type="number" name="year" value="@Model.Year" class="form-control" style="width:120px;" />
    <button type="submit" class="btn btn-outline-primary btn-sm">Xem</button>
}

<div class="card mb-3">
    <div class="card-body">
        <div id="chartRevenue" style="height:350px;"></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card"><div class="card-body"><div id="chartStatus" style="height:320px;"></div></div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-body"><div id="chartTop" style="height:320px;"></div></div></div>
    </div>
</div>

