@model _25DH230134_MyStore.Models.ViewModel.OrderSearchVM
@using PagedList.Mvc
@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string dateValue = Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("yyyy-MM-dd") : "";
}
<link rel="stylesheet" href="~/Content/PagedList.css" />

<h2>DANH SÁCH ĐƠN HÀNG</h2>

@if (Model.CustomerID.HasValue)
{
    <div class="alert alert-info">
        Đang xem đơn hàng của khách: <strong>@Model.CustomerFilterName</strong>
        &nbsp; @Html.ActionLink("Xem tất cả đơn", "Index", null, new { @class = "btn btn-sm btn-outline-secondary" })
    </div>
}

@* PHẦN TÌM KIẾM *@
@using (Html.BeginForm("Index", "Orders", FormMethod.Get, new { @class = "row g-2 align-items-end mb-3" }))
{
    if (Model.CustomerID.HasValue)
    {
        <input type="hidden" name="customerId" value="@Model.CustomerID" />
    }
    <div class="col-md-4">
        <label class="form-label">Tên khách hàng</label>
        <input type="text" name="customerName" value="@Model.CustomerName" class="form-control" placeholder="Nhập tên khách hàng" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Trạng thái thanh toán</label>
        <select name="paymentStatus" class="form-select">
            <option value="">-- Tất cả --</option>
            @foreach (var s in Model.PaymentStatuses)
            {
                <option value="@s" @(s == Model.PaymentStatus ? "selected" : "")>@s</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Ngày đặt hàng</label>
        <input type="date" name="orderDate" value="@dateValue" class="form-control" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@* PHẦN DANH SÁCH ĐƠN HÀNG *@
@if (!Model.Orders.Any())
{
    <div class="alert alert-warning text-center"><strong>KHÔNG CÓ</strong></div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-success">
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Thanh toán</th>
                <th>Trạng thái đơn</th>
                <th style="width:170px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Orders)
            {
                <tr>
                    <td>#@item.OrderID</td>
                    <td>@(item.Customer != null ? item.Customer.CustomerName : "N/A")</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="color:red; font-weight:bold;">@item.TotalAmount.ToString("N0") ₫</td>
                    <td>@item.PaymentStatus</td>
                    <td><span class="badge bg-info text-dark">@item.OrderStatus</span></td>
                    <td>
                        @Html.ActionLink("Chi tiết", "DetailedOrder", new { id = item.OrderID }, new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.OrderID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        Trang @Model.Orders.PageNumber / @Model.Orders.PageCount (tổng @Model.Orders.TotalItemCount đơn)
        @Html.PagedListPager(Model.Orders, page => Url.Action("Index", new
        {
            page,
            customerName = Model.CustomerName,
            paymentStatus = Model.PaymentStatus,
            orderDate = dateValue,
            customerId = Model.CustomerID
        }))
    </div>
}