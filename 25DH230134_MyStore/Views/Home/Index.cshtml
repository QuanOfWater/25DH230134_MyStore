@model _25DH230134_MyStore.Models.ViewModel.HomeProductVM

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- NHÚNG FILE CSS TỪ BÊN NGOÀI (Giống bài giảng) -->
<link rel="stylesheet" type="text/css" href="~/Content/CustomerHome.css" />

<!-- 1. Đẩy nội dung vào vùng MENU của Layout -->
@section Menu {
    <h3>Danh mục hoa</h3>
    @{
        var db = new _25DH230134_MyStore.Models.MyStoreEntities();
        var categories = db.Categories.ToList();
    }
    <ul style="list-style:none; padding:0;">
        @foreach (var c in categories)
        {
            <li style="padding:5px 0;">
                @Html.ActionLink(c.CategoryName, "ProductList", "Home", new { categoryId = c.CategoryID }, null)
            </li>
        }
    </ul>
}

<!-- 2. Đẩy nội dung vào vùng BANNER của Layout -->
@*@section Banner {
    <div class="banner">
        <div class="banner-container">
            <a href="#search-input" class="btnBanner">Bắt đầu mua sắm</a>
        </div>
    </div>
}*@

<!-- 3. NỘI DUNG CHÍNH (Nằm trong vùng .content của Layout) -->
<section class="search-section">
    <h2>Tìm kiếm sản phẩm</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="search-container">
            @Html.EditorFor(model => model.SearchTerm, new { htmlAttributes = new { @id = "search-input", @class = "search-input", placeholder = "Nhập từ khóa ... " } })
            <button type="submit" class="search-button">Tìm kiếm</button>
        </div>
    }
</section>

<!-- 4. GỌI CÁC PARTIAL VIEW (Giống bài giảng) -->
<!-- Phần sản phẩm nổi bật -->
@Html.Partial("PVFeatureProduct", Model)

<!-- Phần sản phẩm mới -->
@Html.Partial("PVNewProduct", Model)