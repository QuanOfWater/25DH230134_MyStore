@model _25DH230134_MyStore.Models.ViewModel.CheckoutVM
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>ĐẶT HÀNG</h2>
@using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "row", role = "form" }))
{
    @Html.AntiForgeryToken()
    foreach (var item in Model.CartItems)
    {
        <input type="hidden" name="selectedIds" value="@item.ProductID" />
    }

    <h3>Thông tin đơn hàng</h3>
    <div class="form-group">
        <table class="table">
            <thead>
                <tr>
                    <th colspan="2">Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td><img src="@Url.Content(item.ProductImage)" /></td>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice</td>
                        <td>@item.TotalPrice</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h3>Thông tin giao hàng</h3>
    <div class="form-group">
        @Html.LabelFor(m => m.ShippingAddress, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", @readonly = "readonly", @id = "shippingAddress" })
            @Html.ValidationMessageFor(m => m.ShippingAddress)
            <button type="button" class="btn btn-link" onclick="enableAddressEdit()">Chỉnh sửa</button>
        </div>
    </div>

    <div class="form-group" id="newAddressGroup" style="display:none">
        @Html.Label("Địa chỉ mới", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" id="newShippingAddress" class="form-control" />
        </div>


    </div>
    <div class="form-group">
        @Html.Label("Phương thức giao hàng", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.RadioButtonFor(m => m.DeliveryMethod, "Giao trong ngày") Giao trong ngày (hỏa tốc)<br />
            @Html.RadioButtonFor(m => m.DeliveryMethod, "Giao theo giờ hẹn") Giao theo giờ hẹn<br />
            @Html.ValidationMessageFor(m => m.DeliveryMethod, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.Label("Phương thức thanh toán", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt") Thanh toán khi nhận hoa (COD)<br />
            @Html.RadioButtonFor(m => m.PaymentMethod, "Chuyển khoản") Chuyển khoản ngân hàng<br />
            @Html.RadioButtonFor(m => m.PaymentMethod, "Ví điện tử") Ví MoMo / ZaloPay<br />
            @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.TotalAmount, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control", @readonly = "readonly" })
            @Html.ValidationMessageFor(m => m.TotalAmount)
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10 ">
            <input type="submit" value="Đặt hàng" class="btn btn-primary" onclick="updateShipperAddress()" />
        </div>
    </div>

}


<script>
    function enableAddressEdit() {
        document.getElementById("shippingAddress").removeAttribute("readonly");
        document.getElementById("newAddressGroup").style.display = "block";
    }

    function updateShipperAddress() {
        var newAddress = document.getElementById("newShippingAddress").value;
        if (newAddress) {
            document.getElementById("shippingAddress").value = newAddress;
        }
    }
</script>